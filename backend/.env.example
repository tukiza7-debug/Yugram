# ============================================================
# Yugram Chat Backend - Contoh konfigurasi (salin ke .env)
# ============================================================

# development | test | production
NODE_ENV=development

# Port HTTP + Socket.io
PORT=4000

# Connection string PostgreSQL (WAJIB)
DATABASE_URL=postgresql://yugram:yugram_secret@localhost:5432/yugram_chat

# true jika PostgreSQL memerlukan SSL (cth. managed cloud DB)
DB_SSL=false

# Rahsia JWT - WAJIB min 16 aksara; WAJIB ditukar di production
JWT_SECRET=yugram_dev_secret_change_me
JWT_EXPIRES_IN=7d

# '*' untuk bengkel/dev; di production senaraikan origin dipisah koma,
# cth: https://app.yugram.my,https://admin.yugram.my
CORS_ALLOWED_ORIGINS=*

# Heartbeat Socket.io
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000

# Had kadar hantar mesej per pengguna (sliding window 60 saat)
MESSAGE_RATE_LIMIT_PER_MINUTE=60

# Saiz mukadimah (page size) sejarah mesej
HISTORY_PAGE_SIZE_DEFAULT=30

# (Pilihan) URL endpoint push notification (FCM/APNs relay).
# Kosong = LogTransport (payload push dilog berstruktur ke stdout).
PUSH_ENDPOINT=

# debug | info | warn | error
LOG_LEVEL=info

# Had saiz muat naik media (MB)
MEDIA_MAX_SIZE_MB=10
