<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.TelegramClone" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="android:colorPrimary">@color/telegram_blue</item>
        <item name="android:colorPrimaryDark">@color/telegram_blue_dark</item>
        <item name="android:colorAccent">@color/telegram_accent</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/telegram_blue</item>
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@android:color/white</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!--
            With targetSdk 36, Android 15+ enforces edge-to-edge (content draws
            behind system bars) by default. The screens are not yet inset-aware,
            so opt out to keep the classic status/nav bar background behavior and
            avoid buttons/inputs being hidden behind the navigation bar.
        -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="Theme.TelegramClone.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/telegram_blue</item>
        <item name="android:colorPrimaryDark">@color/telegram_blue_dark</item>
        <item name="android:colorAccent">@color/telegram_accent</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.TelegramClone.Splash" parent="Theme.TelegramClone">
        <item name="android:windowBackground">@color/telegram_blue</item>
    </style>

</resources>
